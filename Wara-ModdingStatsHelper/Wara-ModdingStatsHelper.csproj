<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!--
      netstandard2.1, matching what SPT 4.1 client plugins target. This was net471,
      which is the 4.0-era shape.
    -->
    <TargetFramework>netstandard2.1</TargetFramework>
    <OutputType>Library</OutputType>
    <RootNamespace>ShowMeTheStats</RootNamespace>
    <AssemblyName>Wara-ModdingStatsHelper</AssemblyName>
    <LangVersion>latest</LangVersion>
    <!--
      Carried over from the Properties/AssemblyInfo.cs this project used to hand-write.
      SDK projects generate those attributes, so the file is gone and the values live
      here instead - 1.1.1 is what it declared, and dropping to 1.0 would have been a
      silent downgrade.
    -->
    <Version>1.1.1</Version>
    <AssemblyVersion>1.1.1</AssemblyVersion>
    <FileVersion>1.1.1</FileVersion>
    <Company>wara</Company>
    <Product>Wara-ModdingStatsHelper</Product>
    <AssemblyTitle>Wara-ModdingStatsHelper</AssemblyTitle>

    <OutputPath>bin\$(Configuration)\</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <Deterministic>true</Deterministic>
  </PropertyGroup>

  <!--
    Every reference used to be a "..\..\..\" path, which only resolves when the
    repository sits exactly three levels inside the SPT install. A clone anywhere else
    silently failed to resolve every single one. SptRoot replaces that and can be
    overridden per machine with -p:SptRoot=... or an SptRoot environment variable.
  -->
  <PropertyGroup>
    <SptRoot Condition=" '$(SptRoot)' == '' ">E:\SPT 4.1</SptRoot>
    <SptManaged>$(SptRoot)\EscapeFromTarkov_Data\Managed</SptManaged>
    <SptBepInEx>$(SptRoot)\BepInEx</SptBepInEx>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="0Harmony">
      <HintPath>$(SptBepInEx)\core\0Harmony.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="BepInEx">
      <HintPath>$(SptBepInEx)\core\BepInEx.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!--
      spt-core is deliberately gone. Nothing here uses an SPT.Core type, and no SPT 4.1
      install ships that assembly - keeping it would have failed the build on a
      reference the code never needed.
    -->
    <Reference Include="spt-common">
      <HintPath>$(SptBepInEx)\plugins\spt\spt-common.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="spt-reflection">
      <HintPath>$(SptBepInEx)\plugins\spt\spt-reflection.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Assembly-CSharp">
      <HintPath>$(SptManaged)\Assembly-CSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Comfort">
      <HintPath>$(SptManaged)\Comfort.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Sirenix.Serialization">
      <HintPath>$(SptManaged)\Sirenix.Serialization.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine">
      <HintPath>$(SptManaged)\UnityEngine.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(SptManaged)\UnityEngine.CoreModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.InputLegacyModule">
      <HintPath>$(SptManaged)\UnityEngine.InputLegacyModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.UI">
      <HintPath>$(SptManaged)\UnityEngine.UI.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.UIModule">
      <HintPath>$(SptManaged)\UnityEngine.UIModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.TextRenderingModule">
      <HintPath>$(SptManaged)\UnityEngine.TextRenderingModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Unity.TextMeshPro">
      <HintPath>$(SptManaged)\Unity.TextMeshPro.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <!--
    Fail with the reason rather than with a wall of "type or namespace not found".
  -->
  <Target Name="EnsureSptRoot" BeforeTargets="BeforeBuild;ResolveAssemblyReferences">
    <Error Condition="!Exists('$(SptManaged)\Assembly-CSharp.dll')"
           Text="SptRoot '$(SptRoot)' does not look like an SPT install (missing EscapeFromTarkov_Data\Managed\Assembly-CSharp.dll). Pass -p:SptRoot=... or set the SptRoot environment variable." />
  </Target>

  <!-- Drop the plugin into the install and build the release zip, as before. -->
  <Target Name="CopyToSPT" AfterTargets="Build" Condition="Exists('$(SptRoot)')">
    <MakeDir Directories="$(SptBepInEx)\plugins" />
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(SptBepInEx)\plugins" />
  </Target>

  <Target Name="PackageRelease" AfterTargets="CopyToSPT">
    <RemoveDir Directories="$(ProjectDir)..\Release" />
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(ProjectDir)..\Release\BepInEx\plugins" />
    <ZipDirectory SourceDirectory="$(ProjectDir)..\Release"
                  DestinationFile="$(ProjectDir)..\Release\Wara-ModdingStatsHelper.zip"
                  Overwrite="true" />
  </Target>

</Project>
